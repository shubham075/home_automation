# Copy to .env for local development.
DATABASE_URL="file:./dev.db"
PORT=8080
MQTT_URL="mqtt://localhost:1883"
# Generate a long random string for anything beyond the bench.
JWT_SECRET="change-me-dev-only-secret-at-least-32-chars"
ACCESS_TOKEN_TTL="12h"
# Dev only: devices that announce themselves on an existing site are registered automatically.
# Production uses the BLE claim flow (docs/04-workflows.md W2).
AUTO_REGISTER_DEVICES=true
# Seed data (prisma/seed.ts)
SEED_SITE_ID="demo"
SEED_ADMIN_PHONE="+919000000001"
SEED_ADMIN_PASSWORD="sw6-dev-admin"
