# Copy to .env for local development.
DATABASE_URL="file:./dev.db"
PORT=8080
MQTT_URL="mqtt://localhost:1883"
# Generate a long random string for anything beyond the bench.
JWT_SECRET="change-me-dev-only-secret-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=30
# Broker logins (Mosquitto Dynamic Security). pnpm hub:up creates the admin on first run.
MQTT_ADMIN_USER="hub-backend"
MQTT_ADMIN_PASSWORD="change-me-dev-broker-admin"
# Shared login that unprovisioned boards use only to request their own credentials.
MQTT_BOOTSTRAP_PASSWORD="change-me-dev-bootstrap"
# Dev only: new boards are approved straight into this site. Leave empty to require the BLE claim flow (W2).
DEV_AUTO_APPROVE_SITE="demo"
# Seed data (prisma/seed.ts)
SEED_SITE_ID="demo"
SEED_ADMIN_PHONE="+919000000001"
SEED_ADMIN_PASSWORD="sw6-dev-admin"
