{
  "name": "@sw6/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "db:setup": "prisma migrate dev --name init && prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc -p ."
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.16.0",
    "@sw6/protocol": "workspace:*",
    "fastify": "^5.1.0",
    "mqtt": "^5.10.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.2"
  }
}
